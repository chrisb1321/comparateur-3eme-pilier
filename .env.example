# Copier vers .env.local. Aucune clé n’est fournie ici.

# Commission SFA (https://commission-sfa.vercel.app/) — chemin principal
# Backend réel : PostgREST table public.prospects
CRM_SUPABASE_URL=https://xgzjlkrbqpvjrfdmiuxq.supabase.co
# Jeton service_role (dashboard Supabase) — l’anon du bundle SPA ne passe pas le RLS
CRM_INGEST_TOKEN=
# Optionnel : clé anon du projet (sinon le service_role sert aussi d’apikey)
CRM_ANON_KEY=
# Optionnel : UUID conseiller si la colonne advisor_id est exigée
CRM_DEFAULT_ADVISOR_ID=
# Optionnel : si vous déployez l’edge function manquante public-site-lead
# CRM_INGEST_FUNCTION=public-site-lead

# Secondaire : e-mail d’équipe (seulement si le CRM n’est pas le canal voulu)
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
LEAD_FROM_NAME=Comparateur 3ème pilier
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
