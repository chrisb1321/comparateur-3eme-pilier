# Copier vers .env.local. Aucune clé n’est fournie ici.

# Commission SFA (https://commission-sfa.vercel.app/) — chemin principal
# Edge Function public-site-lead (projet xgzjlkrbqpvjrfdmiuxq)
CRM_SUPABASE_URL=https://xgzjlkrbqpvjrfdmiuxq.supabase.co
# Secret partagé avec SITE_LEAD_INGEST_SECRET — jamais la service_role
CRM_INGEST_TOKEN=
CRM_INGEST_FUNCTION=public-site-lead
# Optionnel : UUID conseiller (sinon advisor_id reste null)
CRM_DEFAULT_ADVISOR_ID=

# Journal local de secours (Vercel : /tmp, disque éphémère)
LEAD_JOURNAL_PATH=/tmp/comparateur-3eme-pilier-leads.jsonl

# Secondaire : e-mail d’équipe (seulement si l’ingest n’est pas le canal voulu)
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
LEAD_FROM_NAME=Comparateur 3ème pilier
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
